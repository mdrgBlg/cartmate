rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // Catalog: read-only for signed-in users, managed from the console.
    match /Products/{id}   { allow read: if signedIn(); allow write: if false; }
    match /Categories/{id} { allow read: if signedIn(); allow write: if false; }
    match /Brands/{id}     { allow read: if signedIn(); allow write: if false; }

    match /Users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && request.resource.data.id == uid;
      // Email is read-only in the app; it must match Firebase Auth.
      allow update: if isOwner(uid)
        && request.resource.data.id == uid
        && request.resource.data.email == resource.data.email;
      allow delete: if false;

      // Orders are immutable once placed.
      match /Orders/{orderId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false;
      }

      match /Wishlist/{productId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
